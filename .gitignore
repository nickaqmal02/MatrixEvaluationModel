# These are regenerated on every `quarto render`
model_evaluation_files/
*.quarto_ipynb
*.quarto_ipynb_1
.jupytercache/
.jupyter_cache/
.quarto/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
venv/
.venv/

# ── OS junk ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

/.quarto/
**/*.quarto_ipynb
